{
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "**/*.fixtures.tsx", "**/*.fixtures.ts", "**/*.test.ts", "**/*.test.tsx"],
  "compilerOptions": {
    "noEmit": false,
    "sourceMap": false,
    "strict": true,
    "module": "commonjs",
    "target": "ES5",
    "outDir": "./cjs",
    "skipLibCheck": true
  }
}
